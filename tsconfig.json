{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": false,
    "esModuleInterop": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "pageObjects/*": ["src/pageObjects/*"]
    }
  },
  "exclude": ["node_modules"]
}
